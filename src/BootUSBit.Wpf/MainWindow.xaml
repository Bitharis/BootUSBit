<Window x:Class="BootUSBit.Wpf.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:BootUSBit.Wpf"
        mc:Ignorable="d"
        Title="BootUSBit - Multiboot USB Creator" Height="560" Width="860"
        Loaded="Window_Loaded">
    <Window.DataContext>
        <local:MainViewModel />
    </Window.DataContext>
    <Window.Resources>
        <BooleanToVisibilityConverter x:Key="BoolToVisibilityConverter" />
    </Window.Resources>
    <Grid Margin="12">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="150" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <!-- USB drive selection -->
        <GroupBox Grid.Row="0" Header="Target USB drive" Padding="8">
            <DockPanel>
                <Button DockPanel.Dock="Right" Content="Refresh" Width="90" Margin="8,0,0,0"
                        Command="{Binding RefreshDrivesCommand}" />
                <ComboBox ItemsSource="{Binding Drives}" SelectedItem="{Binding SelectedDrive}"
                          DisplayMemberPath="Model" MinHeight="28" />
            </DockPanel>
        </GroupBox>

        <!-- ISO list -->
        <GroupBox Grid.Row="1" Header="ISOs to add (in menu order)" Margin="0,8,0,0" Padding="8">
            <DockPanel>
                <StackPanel DockPanel.Dock="Right" Width="110" Margin="8,0,0,0">
                    <Button Content="Add ISO..." Command="{Binding AddIsoCommand}" Margin="0,0,0,6" />
                    <Button Content="Remove" Command="{Binding RemoveIsoCommand}"
                            CommandParameter="{Binding SelectedIso}" />
                </StackPanel>
                <ListBox ItemsSource="{Binding Isos}" SelectedItem="{Binding SelectedIso}"
                          DisplayMemberPath="DisplayName" />
            </DockPanel>
        </GroupBox>

        <!-- Status + progress -->
        <StackPanel Grid.Row="2" Margin="0,8,0,0">
            <CheckBox Content="Write raw ISO image (single ISO only, no multiboot menu)"
                      IsChecked="{Binding IsRawImageMode}" Margin="0,0,0,4" />
            <TextBlock Text="{Binding StatusText}" FontWeight="Bold" />
            <ProgressBar Height="14" Margin="0,4,0,0" Minimum="0" Maximum="100"
                         Value="{Binding BuildProgress, Mode=OneWay}" Visibility="{Binding IsBusy, Converter={StaticResource BoolToVisibilityConverter}}" />
        </StackPanel>

        <!-- Log -->
        <GroupBox Grid.Row="3" Header="Log" Margin="0,4,0,0" Padding="4">
            <ListBox ItemsSource="{Binding LogLines}" FontFamily="Consolas" FontSize="11" />
        </GroupBox>

        <!-- Actions -->
        <StackPanel Grid.Row="4" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,8,0,0">
            <Button Content="Cancel" Width="90" Margin="0,0,8,0"
                    Command="{Binding CancelBuildCommand}" IsEnabled="{Binding IsBusy}" />
            <Button Content="Create USB" Width="120" Command="{Binding BuildCommand}" />
        </StackPanel>
    </Grid>
</Window>
