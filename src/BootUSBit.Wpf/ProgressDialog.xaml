<Window x:Class="BootUSBit.Wpf.ProgressDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Creating USB"
        Width="760" Height="510"
        MinWidth="620" MinHeight="400"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        WindowStyle="None"
        ShowInTaskbar="False"
        Icon="{StaticResource AppLogo}"
        Background="{StaticResource WindowBrush}"
        Foreground="{StaticResource TextBrush}"
        FontFamily="Bahnschrift"
        Closing="Window_Closing">
    <Window.Resources>
        <WindowChrome x:Key="WindowChrome" CaptionHeight="36" ResizeBorderThickness="0" UseAeroCaptionButtons="False" GlassFrameThickness="0" />
    </Window.Resources>
    <WindowChrome.WindowChrome>
        <StaticResource ResourceKey="WindowChrome" />
    </WindowChrome.WindowChrome>
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="36" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Grid Grid.Row="0" Background="{StaticResource ChromeBrush}" MouseLeftButtonDown="TitleBar_MouseLeftButtonDown">
            <StackPanel Orientation="Horizontal" VerticalAlignment="Center" Margin="14,0,0,0">
                <Image Source="{StaticResource AppLogo}" Width="20" Height="20" Margin="0,0,9,0" />
                <TextBlock Text="BOOTUSBIT" FontSize="12" FontWeight="Bold" Foreground="{StaticResource AccentBrush}" VerticalAlignment="Center" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="—" Width="44" Height="36" Padding="0" Click="WindowMinimize_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CaptionButton}" />
                <Button Content="X" Width="44" Height="36" Padding="0" Click="WindowClose_Click"
                        WindowChrome.IsHitTestVisibleInChrome="True" Style="{StaticResource CaptionCloseButton}" />
            </StackPanel>
        </Grid>

        <Grid Grid.Row="1" Margin="24">
            <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <StackPanel>
            <TextBlock Text="BUILDING USB DRIVE" Foreground="{StaticResource AccentBrush}"
                       FontSize="12" FontWeight="Bold" />
            <TextBlock Text="{Binding StatusText}" FontSize="22" FontWeight="SemiBold" Margin="0,5,0,0" />
        </StackPanel>

        <Grid Grid.Row="1" Margin="0,22,0,18">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <ProgressBar Height="8" Minimum="0" Maximum="100" Value="{Binding BuildProgress}" />
            <TextBlock Grid.Column="1" Text="{Binding StatusIndicator}" Foreground="{StaticResource AccentBrush}"
                       FontSize="11" FontWeight="Bold" VerticalAlignment="Center" Margin="14,0,0,0" />
        </Grid>

        <Border Grid.Row="2" Background="#0D0F13" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="1" CornerRadius="8" Padding="12">
            <DockPanel>
                <TextBlock DockPanel.Dock="Top" Text="ACTIVITY" Foreground="{StaticResource MutedTextBrush}"
                           FontSize="11" FontWeight="Bold" Margin="0,0,0,7" />
                <ListBox ItemsSource="{Binding LogLines}" FontFamily="Cascadia Mono" FontSize="11"
                         Background="Transparent" BorderThickness="0" Foreground="#B8C0CC" />
            </DockPanel>
        </Border>

        <Button Grid.Row="3" Content="Cancel build" Style="{StaticResource DangerButton}" Width="126"
                HorizontalAlignment="Right" Margin="0,18,0,0" Command="{Binding CancelBuildCommand}" />
        </Grid>
    </Grid>
</Window>