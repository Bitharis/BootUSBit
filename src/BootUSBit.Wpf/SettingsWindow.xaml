<Window x:Class="BootUSBit.Wpf.SettingsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Settings" SizeToContent="WidthAndHeight" WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize" ShowInTaskbar="False">
    <StackPanel Margin="18">
        <TextBlock Text="Logging" FontWeight="Bold" Margin="0,0,0,12" />
        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto" />
                <ColumnDefinition Width="160" />
            </Grid.ColumnDefinitions>
            <TextBlock Grid.Column="0" Text="Minimum log level:" VerticalAlignment="Center" Margin="0,0,12,0" />
            <ComboBox x:Name="LogLevelComboBox" Grid.Column="1" DisplayMemberPath="Name" />
        </Grid>
        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,18,0,0">
            <Button Content="Cancel" IsCancel="True" Width="80" Margin="0,0,8,0" />
            <Button Content="Apply" IsDefault="True" Width="80" Click="Apply_Click" />
        </StackPanel>
    </StackPanel>
</Window>
